# bbtt 前端：/ 与 /bbtt/ 提供新客户端，其余路径（API、/web 原生界面、/socket）反向代理到 Jellyfin。
map $http_upgrade $connection_upgrade {
  default upgrade;
  ""      close;
}

# 媒体 URL 查询串含 ApiKey，访问日志不记录查询串
log_format bbtt '$remote_addr [$time_local] "$request_method $uri" $status $body_bytes_sent $request_time';

upstream jellyfin {
  server ${JELLYFIN_UPSTREAM};
  keepalive 16;
}

server {
  listen 80;
  server_name _;
  client_max_body_size 0;
  root /usr/share/nginx/html;

  access_log /dev/stdout bbtt;

  location = / {
    add_header Cache-Control "no-cache";
    try_files /bbtt/index.html =404;
  }

  location = /bbtt/index.html {
    add_header Cache-Control "no-cache";
  }

  location /bbtt/assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  location /bbtt/ {
    try_files $uri /bbtt/index.html;
  }

  location / {
    proxy_pass http://jellyfin;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }
}
